#!/usr/bin/env bash
# Fails closed: a missing script blocks the commit.
root="$(git rev-parse --show-toplevel)" || exit 1
for s in sweep.sh check.sh; do
    [ -x "$root/scripts/$s" ] || { echo "pre-commit: scripts/$s is missing; refusing to commit." >&2; exit 1; }
done
exec "$root/scripts/check.sh" --fast
