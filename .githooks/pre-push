#!/usr/bin/env bash
# Identity and leak sweeps of the outgoing commits. Fails closed: a missing script
# blocks the push. Unit tests no longer run here: they took about 400 s, and CI runs
# them on the pushed commit (D-76).
root="$(git rev-parse --show-toplevel)" || exit 1
[ -x "$root/scripts/sweep.sh" ] || { echo "pre-push: scripts/sweep.sh is missing; refusing to push." >&2; exit 1; }
exec "$root/scripts/sweep.sh" --pre-push
